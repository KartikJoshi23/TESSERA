# Copy this file to `.env` (which is git-ignored). Never commit real values.

# Operating mode:
#   RESTRICTED_DEMO   – default; DFSA hand-recorded facts never load (safe for screenshots and talks)
#   RESEARCH_INTERNAL – local research only; DFSA facts load from data/restricted/
TESSERA_MODE=RESTRICTED_DEMO

# NVIDIA API catalog key (free tier). Needed from Part 2 onwards; create it at build.nvidia.com.
NVIDIA_API_KEY=
