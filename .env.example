# This file is public. Do not put your key here.
# Copy it to a new file named `.env` (which is git-ignored), and put your key in that copy.

# Operating mode:
#   RESTRICTED_DEMO   – default; DFSA hand-recorded facts never load (safe for screenshots and talks)
#   RESEARCH_INTERNAL – local research only; DFSA facts load from data/restricted/
TESSERA_MODE=RESTRICTED_DEMO

# NVIDIA API catalog key (free tier). Create one at build.nvidia.com. Leave this line empty here.
NVIDIA_API_KEY=
